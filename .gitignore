# Build output. These are anchored with a leading slash on purpose: a bare
# `companion` pattern also matches the cmd/companion source directory and would
# silently untrack the entrypoint.
/dist/
/bin/
/companion
/companion.exe

# A staged converter binary. Nothing stages one any more; the rule stays so a
# program copied into internal/converter/embedded/ can never be committed. It was
# how a binary reached the build immediately before
# `go build` and clears it afterwards — it must never be committed. .gitkeep is
# the only tracked file in that directory.
/internal/converter/embedded/*
!/internal/converter/embedded/.gitkeep

# Downloaded external tool cache.
#
# The default cache is in the OS cache directory, not here, but a local
# override (config.json's tool_cache_dir) commonly points at the working tree.
# These are third-party GPL-2.0 binaries and must never be committed — see
# THIRD_PARTY_NOTICES.md.
/tools-cache/
/external-tools/

# Local config written by the app when its config path is overridden.
/config.json

# macOS bundles produced by build/macos/make-app-bundle.sh
*.app/

# Go
# The Windows icon resource build/release.sh generates (build/icon) for the
# length of a release build.
*.syso
*.test
*.out
*.exe
*.so
*.dylib
go.work
go.work.sum
/vendor/

# Editors and OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# The optional development .env (see .env.example). Never committed.
/.env

# Python bytecode. The release scripts under build/ do not write it
# (sys.dont_write_bytecode), because an untracked file makes `go build` stamp
# vcs.modified=true; this only keeps a stray one out of a commit.
__pycache__/
# trail: local repo context graph and learnings, never committed (HITL 2026-11-11)
/.trail/

# Impeccable (vendored design skill, .claude/skills/impeccable): runtime state, never tracked.
**/skills/impeccable/scripts/bin/
**/skills/impeccable/scripts/config.json
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
.impeccable/live/
.impeccable/history/
.impeccable/config.local.json
.impeccable/critique/*
!.impeccable/critique/ignore.md
.impeccable-live.json
.impeccable-live/

[Desktop Entry]
Type=Application
Name=Auto-Pigeon Companion join link
Comment=Show an autopigeon:// join link in the Companion, starting nothing
# `game open` (244F): it checks the link's shape, records it for the page, and
# starts or raises the Companion's own page, which shows what this computer
# still needs. It starts no game and has no approval flag. A URL is a string
# somebody else chose, and a handler that launched on arrival would make a link
# an execution primitive.
#
# %u, so the URL arrives as one argument. No shell is involved.
Exec=companion game open %u
# The review happens in the Companion's page, so no terminal is opened.
Terminal=false
# NoDisplay, because auto-pigeon-companion.desktop is the launcher. This entry
# exists only to declare the scheme, and a second Auto-Pigeon Companion in the
# applications menu would be a bug.
NoDisplay=true
MimeType=x-scheme-handler/autopigeon;

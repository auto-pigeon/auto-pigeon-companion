<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist template for the Auto-Pigeon Companion .app bundle.

  @PLACEHOLDER@ tokens are substituted by build/macos/make-app-bundle.sh:
    @BUNDLE_ID@   the CFBundleIdentifier
    @VERSION@     the release version, e.g. 0.1.0
    @ARCH@        the Go architecture the bundled binary was built for
    @EXECUTABLE@  the executable name inside Contents/MacOS
    @COPYRIGHT@   the human-readable copyright and licensing line

  No GUI toolkit generates this bundle: the Companion has no GUI dependency, so
  the .app is assembled by hand around a plain cross-compiled binary. That is
  the whole reason this file exists.

  LSUIElement is true: launching the bundle starts a local server and opens the
  user's browser, so there is no Cocoa window to own and a windowless process in
  the Dock reads as a hung app.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Auto-Pigeon Companion</string>
    <key>CFBundleDisplayName</key>
    <string>Auto-Pigeon Companion</string>
    <key>CFBundleIdentifier</key>
    <string>@BUNDLE_ID@</string>
    <key>CFBundleVersion</key>
    <string>@VERSION@</string>
    <key>CFBundleShortVersionString</key>
    <string>@VERSION@</string>
    <key>CFBundleExecutable</key>
    <string>@EXECUTABLE@</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <!-- The architecture the bundle was built for, recorded for support: @ARCH@ -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>@COPYRIGHT@</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist template for the Auto-Pigeon Companion .app bundle.

  @PLACEHOLDER@ tokens are substituted by build/macos/make-app-bundle.sh:
    @BUNDLE_ID@   the CFBundleIdentifier
    @VERSION@     the release version, e.g. 0.1.0
    @ARCH@        the Go architecture the bundled binary was built for
    @EXECUTABLE@  the executable name inside Contents/MacOS
    @COPYRIGHT@   the human-readable copyright and licensing line

  No GUI toolkit generates this bundle: the Companion has no GUI dependency, so
  the .app is assembled by hand around a plain cross-compiled binary. That is
  the whole reason this file exists.

  LSUIElement is true: launching the bundle starts a local server and opens the
  user's browser, so there is no Cocoa window to own and a windowless process in
  the Dock reads as a hung app.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Auto-Pigeon Companion</string>
    <key>CFBundleDisplayName</key>
    <string>Auto-Pigeon Companion</string>
    <key>CFBundleIdentifier</key>
    <string>@BUNDLE_ID@</string>
    <key>CFBundleVersion</key>
    <string>@VERSION@</string>
    <key>CFBundleShortVersionString</key>
    <string>@VERSION@</string>
    <key>CFBundleExecutable</key>
    <string>@EXECUTABLE@</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <!-- The architecture the bundle was built for, recorded for support: @ARCH@ -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>@COPYRIGHT@</string>
    <!--
      The autopigeon:// handler. On macOS this is the ONLY declaration there
      is: LaunchServices reads it out of the bundle when the .app is installed,
      and there is no supported way to register a scheme for a loose
      executable. `companion uri register` says so rather than inventing one.

      Opening a link runs the bundle, which runs `companion game join <url>`
      with no --approve: it resolves the link, prints the command it would run,
      and starts nothing. A URL is a string somebody else chose.

      Viewer role, not Editor: this application does not own or edit anything
      the scheme names.
    -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>@BUNDLE_ID@.join</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>autopigeon</string>
            </array>
        </dict>
    </array>
</dict>
</plist>

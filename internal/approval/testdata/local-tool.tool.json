{
  "schema_version": "aucom.profile/1.1",
  "kind": "tool",
  "id": "example.local.harmless",
  "version": "1.0.0",
  "name": "A tool profile somebody wrote",
  "summary": "A hand-written tool profile that copies one file, so that approving it can be tested without a compiler.",
  "description": "This document exists so that the CLI's approval path can be exercised against a TOOL profile \u2014 the kind AUT/AUCOM 219 found could be validated, shown, digested and bound from the command line, and then only ever run through the local HTTP API. It declares one program, one action, and the workspace root, which is the smallest thing a tool profile can be and still be a tool profile.",
  "publisher": {
    "name": "A Companion user"
  },
  "license": {
    "spdx": "MIT",
    "name": "MIT License"
  },
  "tool_version": "1.0.0",
  "game_profile": {
    "engine_family": "quake1",
    "slug": "quake1"
  },
  "platforms": [
    {
      "platform": {
        "os": "linux",
        "arch": "amd64"
      },
      "status": "supported"
    },
    {
      "platform": {
        "os": "darwin",
        "arch": "arm64"
      },
      "status": "supported"
    },
    {
      "platform": {
        "os": "windows",
        "arch": "amd64"
      },
      "status": "supported"
    }
  ],
  "acquisition": [
    {
      "mode": "user_path",
      "title": "The copy I already have",
      "hint": "choose the folder the program is in"
    }
  ],
  "capabilities": [
    {
      "id": "q1.bsp.compile",
      "title": "Compile a Quake 1 map into a BSP",
      "consumes": [
        "q1.map.source"
      ],
      "produces": [
        "q1.bsp"
      ]
    }
  ],
  "executables": [
    {
      "name": "harmless",
      "file": "harmless{platform.exe_suffix}"
    }
  ],
  "actions": [
    {
      "id": "compile",
      "title": "Compile the map",
      "capability": "q1.bsp.compile",
      "executable": "harmless",
      "working_dir": {
        "root": "workspace"
      },
      "args": [
        "{input.source_map}",
        "{output.bsp}"
      ],
      "inputs": [
        {
          "name": "source_map",
          "role": "q1.map.source",
          "required": true,
          "title": "Map source",
          "extensions": [
            ".map"
          ]
        }
      ],
      "outputs": [
        {
          "name": "bsp",
          "role": "q1.bsp",
          "title": "Compiled BSP",
          "path": "compile/level.bsp"
        }
      ],
      "roots": [
        {
          "role": "workspace",
          "access": "read_write",
          "purpose": "read the staged map source and write the compiled BSP"
        },
        {
          "role": "content_root",
          "access": "read",
          "purpose": "read the project's own textures while compiling"
        }
      ],
      "timeout_seconds": 600
    }
  ]
}

{
  "schema_version": "aucom.profile/1.0",
  "kind": "pipeline",
  "id": "auto-pigeon.sample.q1-normal",
  "version": "1.0.0",
  "name": "Sample Q1 normal build",
  "summary": "Compile, compute visibility, compute lighting — the ordinary Quake 1 build.",
  "description": "Every step names a capability rather than a tool. Nothing in this document says which program compiles the map: that is answered on the machine, by whichever installed and granted profile provides `q1.bsp.compile`. Swapping compilers is therefore a change to what is installed, not a change to this file — and a pipeline can be shared with somebody who uses a different toolchain.",
  "publisher": {
    "name": "Auto-Pigeon",
    "url": "https://github.com/andrea-dintino/auto-pigeon-companion"
  },
  "license": { "spdx": "MIT", "name": "MIT" },
  "compatibility": { "companion": { "at_least": "0.1.0" } },
  "game_profile": { "slug": "quake1", "engine_family": "quake1" },
  "inputs": [
    { "name": "source_map", "title": "Map source", "role": "q1.map.source", "required": true, "extensions": [".map"] }
  ],
  "steps": [
    {
      "id": "compile",
      "title": "Compile the map",
      "capability": "q1.bsp.compile",
      "inputs": [{ "name": "source_map", "from": "pipeline.source_map" }],
      "options": { "threads": "4" }
    },
    {
      "id": "vis",
      "title": "Compute visibility",
      "capability": "q1.bsp.vis",
      "inputs": [{ "name": "bsp", "from": "compile.bsp" }]
    },
    {
      "id": "light",
      "title": "Compute lighting",
      "capability": "q1.bsp.light",
      "inputs": [{ "name": "bsp", "from": "vis.bsp" }]
    }
  ],
  "outputs": [
    { "name": "bsp", "title": "The finished BSP", "role": "q1.bsp.lit", "from": "light.bsp" },
    { "name": "lit", "title": "Coloured lighting", "role": "q1.lit", "from": "light.lit", "optional": true }
  ]
}

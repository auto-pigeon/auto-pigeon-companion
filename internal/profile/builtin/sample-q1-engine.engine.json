{
  "schema_version": "aucom.profile/1.1",
  "kind": "engine",
  "id": "auto-pigeon.sample.q1-engine",
  "version": "1.0.0",
  "name": "Sample Q1 engine",
  "summary": "A worked example of the engine profile format, covering all five session actions.",
  "description": "A sample, not a qualified engine profile. The curated Ironwail, vkQuake, QuakeSpasm, QSS, DarkPlaces and FTEQW profiles are added by the task that qualifies them against upstream documentation; this one exists so the format has a complete example that ships in the build, and so the five actions and the three session roles are exercised by the tests.\n\nNote what the three roles buy: joining, hosting a listen server and running a dedicated server are separate actions with separate permissions, so a user who pressed something labelled Play is never quietly running a server other people can connect to.",
  "publisher": {
    "name": "Auto-Pigeon",
    "url": "https://github.com/andrea-dintino/auto-pigeon-companion"
  },
  "license": {
    "spdx": "GPL-2.0-or-later",
    "name": "GNU General Public License v2.0 or later",
    "notice": "Quake engine source ports are separate programs under the GNU GPL. This profile configures one; it does not contain, link or relicense it. Game data — PAK files, maps, textures shipped with a commercial release — is not covered by that licence and is never copied, uploaded or redistributed by the Companion."
  },
  "compatibility": { "companion": { "at_least": "0.1.0" } },
  "game_profile": { "slug": "quake1", "engine_family": "quake1" },
  "runtime": "sample-q1",
  "engine_version": "0.0.0-sample",
  "last_qualified": "2026-09-06",
  "platforms": [
    { "platform": { "os": "linux", "arch": "amd64" }, "status": "supported" },
    { "platform": { "os": "windows", "arch": "amd64" }, "status": "supported" },
    { "platform": { "os": "darwin", "arch": "arm64" }, "status": "unverified", "note": "no macOS build has been run by the authors" }
  ],
  "acquisition": [
    { "mode": "user_path", "title": "Use an engine you already have", "hint": "choose the engine executable" }
  ],
  "content_layouts": [
    { "id": "id1", "title": "The base game", "kind": "loose_files", "root": "game_root", "path": "id1" },
    { "id": "mod", "title": "A mod or project directory", "kind": "mod_directory", "root": "content_root" },
    { "id": "pak", "title": "A PAK archive in the base game", "kind": "pak", "root": "game_root", "path": "id1" }
  ],
  "executables": [
    { "name": "engine", "title": "The engine", "file": "sample-q1{platform.exe_suffix}" }
  ],
  "actions": [
    {
      "id": "play_map",
      "title": "Play a map",
      "session_role": "client",
      "executable": "engine",
      "working_dir": { "root": "game_root" },
      "args": ["-basedir", "{root.game_root}", "+map", "{runtime.map_name}"],
      "roots": [
        { "role": "game_root", "access": "read", "purpose": "load the base game" },
        { "role": "content_root", "access": "read", "purpose": "load the map being tested" }
      ]
    },
    {
      "id": "play_package",
      "title": "Play a mod or package",
      "session_role": "client",
      "executable": "engine",
      "working_dir": { "root": "game_root" },
      "args": ["-basedir", "{root.game_root}", "-game", "{runtime.mod_name}"],
      "roots": [
        { "role": "game_root", "access": "read", "purpose": "load the base game" },
        { "role": "content_root", "access": "read", "purpose": "load the mod" }
      ]
    },
    {
      "id": "join_server",
      "title": "Join a server",
      "session_role": "client",
      "executable": "engine",
      "working_dir": { "root": "game_root" },
      "args": ["-basedir", "{root.game_root}", "+connect", "{runtime.server_host}:{runtime.server_port}"],
      "roots": [{ "role": "game_root", "access": "read", "purpose": "load the base game" }],
      "network": {
        "required": true,
        "purpose": "connect to the server the user names"
      }
    },
    {
      "id": "host_listen",
      "title": "Host a game and play in it",
      "session_role": "listen_server",
      "executable": "engine",
      "working_dir": { "root": "game_root" },
      "args": ["-basedir", "{root.game_root}", "+maxplayers", "{option.max_players}", "+map", "{runtime.map_name}"],
      "options": [
        { "name": "max_players", "title": "Maximum players", "type": "integer", "default": "8", "minimum": 2, "maximum": 32 }
      ],
      "roots": [
        { "role": "game_root", "access": "read", "purpose": "load the base game" },
        { "role": "content_root", "access": "read", "purpose": "load the map being hosted" }
      ],
      "network": { "required": true, "purpose": "accept connections from other players" }
    },
    {
      "id": "host_dedicated",
      "title": "Run a dedicated server",
      "session_role": "dedicated_server",
      "executable": "engine",
      "working_dir": { "root": "game_root" },
      "args": ["-dedicated", "{option.max_players}", "-basedir", "{root.game_root}", "+map", "{runtime.map_name}"],
      "options": [
        { "name": "max_players", "title": "Maximum players", "type": "integer", "default": "8", "minimum": 2, "maximum": 32 }
      ],
      "roots": [
        { "role": "game_root", "access": "read", "purpose": "load the base game" },
        { "role": "content_root", "access": "read", "purpose": "load the map being hosted" }
      ],
      "network": { "required": true, "purpose": "accept connections from other players" }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-pigeon.invalid/schema/aucom.profile/1.0/tool",
  "title": "Auto-Pigeon Companion tool profile 1.0",
  "description": "One external program, or one family of programs shipped together, that the Companion can run on a user's behalf. The program is a separate process under its own licence; this document is configuration for it and does not relicense it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "name",
    "summary",
    "publisher",
    "license",
    "tool_version",
    "platforms",
    "acquisition",
    "executables",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": "aucom.profile/1.0"
    },
    "kind": {
      "const": "tool"
    },
    "id": {
      "$ref": "profile-common-1.0.schema.json#/$defs/profileId"
    },
    "version": {
      "$ref": "profile-common-1.0.schema.json#/$defs/version"
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "publisher": {
      "$ref": "profile-common-1.0.schema.json#/$defs/publisher"
    },
    "source": {
      "$ref": "profile-common-1.0.schema.json#/$defs/source"
    },
    "license": {
      "$ref": "profile-common-1.0.schema.json#/$defs/license"
    },
    "compatibility": {
      "$ref": "profile-common-1.0.schema.json#/$defs/compatibility"
    },
    "game_profile": {
      "$ref": "profile-common-1.0.schema.json#/$defs/gameProfileRef"
    },
    "tool_version": {
      "type": "string",
      "maxLength": 64,
      "description": "The upstream program's version, which is not this document's version."
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "profile-common-1.0.schema.json#/$defs/platformSupport"
      }
    },
    "acquisition": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "profile-common-1.0.schema.json#/$defs/acquisitionOption"
      }
    },
    "version_probe": {
      "$ref": "profile-common-1.0.schema.json#/$defs/versionProbe"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "profile-common-1.0.schema.json#/$defs/capability"
      }
    },
    "executables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "profile-common-1.0.schema.json#/$defs/executable"
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "profile-common-1.0.schema.json#/$defs/action"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/auto-pigeon/auto-pigeon-libraries/ts/operational-notice-contract/schema/operational-notices-response-1.0.schema.json",
  "title": "AUB operational notices, read response, version 1.0",
  "description": "What `GET /api/operational-notices?surface=<surface>` answers. CLOSED: no audit identity, no enabled flag, no target-surface list and no row that is disabled, expired or further away than the look-ahead is ever in it. Phase (upcoming/active/expired) is NOT stored or sent; every client derives it from `server_time` and the three instants.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "server_time", "surface", "visibility", "poll_after_seconds", "notices"],
  "properties": {
    "schema": { "const": "auto-pigeon-operational-notices/1.0" },
    "server_time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "surface": { "enum": ["aup", "aug", "aucom"] },
    "visibility": { "enum": ["public", "authenticated"], "description": "What the caller was served: `authenticated` when a valid account token accompanied the request, so authenticated-only notices were eligible." },
    "poll_after_seconds": { "type": "integer", "minimum": 60, "maximum": 120 },
    "notices": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "title", "body", "severity", "show_from", "starts_at", "ends_at", "visibility", "dismissible"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]{15}$" },
          "revision": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "body": { "type": "string", "maxLength": 600 },
          "severity": { "enum": ["critical", "maintenance", "warning", "info"] },
          "show_from": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
          "starts_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
          "ends_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
          "visibility": { "enum": ["public", "authenticated"] },
          "dismissible": { "type": "boolean" }
        }
      }
    }
  }
}

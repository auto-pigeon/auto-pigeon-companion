{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "additionalDirectories": [
      "..",
      "../../mapper"
    ],
    "deny": [
      "Read(**/run-sequence.sh)",
      "Edit(**/run-sequence.sh)",
      "Edit(**/ai-mapcopilot/**)",
      "Edit(**/auto-pigeon/**)",
      "Edit(**/auto-pigeon-collaboration/**)",
      "Edit(**/auto-pigeon-gallery/**)",
      "Edit(**/auto-pigeon-launcher/**)",
      "Edit(**/auto-pigeon-libraries/**)",
      "Edit(**/auto-pigeon-telemetry/**)",
      "Edit(**/mapper-code/mapper/**)"
    ],
    "allow": [
      "Bash(trail:*)",
      "Bash(graft:*)",
      "Bash(npx graft:*)",
      "Bash(graft-dev:*)",
      "Bash(node dist/cli.js:*)"
    ]
  },
  "enabledMcpjsonServers": [
    "graft"
  ],
  "statusLine": {
    "type": "command",
    "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.trail/statusline.cjs\""
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.trail/statusline.cjs\""
  },
  "footerLinksRegexes": [
    "graft/[\\w./-]+\\.md"
  ]
}
